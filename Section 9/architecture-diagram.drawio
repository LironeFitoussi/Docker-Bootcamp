        <!-- Additional Details Box -->
        <mxCell id="details" value="Architecture Details:&#xa;• ECS Cluster: goals-cluster (Fargate)&#xa;• Service: goals-app (Desired: 1)&#xa;• Multi-AZ: 3 Availability Zones&#xa;• High Availability: ALB + EFS across AZs&#xa;• Persistent Storage: EFS for MongoDB data&#xa;• Health Checks: Container + Target Group&#xa;• Security: Multiple security groups&#xa;• Logging: CloudWatch Logs integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="1540" width="500" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="data-flow" value="Data Flow:&#xa;1. User → ALB (HTTP:80)&#xa;2. ALB → Target Group (health check)&#xa;3. Target Group → ECS Task (backend:80)&#xa;4. Backend → MongoDB (localhost:27017)&#xa;5. MongoDB → EFS (/data/db)&#xa;6. Response back through ALB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
